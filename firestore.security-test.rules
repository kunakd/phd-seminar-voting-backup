rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /votes/{id} { allow read, write: if false; }
  match /msc_votes/{id} { allow read, write: if false; }
  match /settings/{id} { allow read, write: if false; }
  match /users/{id} { allow read, write: if false; }
  function eligible() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.email is string
    && request.auth.token.email.matches('^[^@]+@(natur[.]cuni[.]cz|uochb[.]cas[.]cz)$');
  }
  function validItem(p, n) {
   return p is map && p.keys().hasOnly(['name','score','comment'])
    && p.keys().hasAll(['name','score','comment'])
    && p.name == n && p.score is int && p.score >= 1 && p.score <= 10
    && p.comment is string && p.comment.size() <= 2000;
  }
  function validSeminar(d) {
   return false
    || (d.seminar == 'Seminar 1' && request.time >= timestamp.value("2020-01-01T00:00:00Z") && request.time < timestamp.value("2099-01-01T00:00:00Z") && d.presentations.size() == 4 && validItem(d.presentations[0], "Botond Bolgár") && validItem(d.presentations[1], "Tereza Kárníková") && validItem(d.presentations[2], "Deepak Kumar Bhuyan") && validItem(d.presentations[3], "Aparna Vijayalekshmi Muraleedharan"))
    || (d.seminar == 'Seminar 2' && request.time >= timestamp.value("2026-12-10T23:00:00Z") && request.time < timestamp.value("2026-12-17T23:00:00Z") && d.presentations.size() == 4 && validItem(d.presentations[0], "Amálie Amiot Vanoušková") && validItem(d.presentations[1], "Paritosh Dey") && validItem(d.presentations[2], "Laura Juliana Prieto Pabon") && validItem(d.presentations[3], "Jan Jurica"))
    || (d.seminar == 'Seminar 3' && request.time >= timestamp.value("2027-01-14T23:00:00Z") && request.time < timestamp.value("2027-01-21T23:00:00Z") && d.presentations.size() == 5 && validItem(d.presentations[0], "Vilém Blahout") && validItem(d.presentations[1], "Radek Staník") && validItem(d.presentations[2], "Marko Bogomolec") && validItem(d.presentations[3], "Matthew Zagorey Todd") && validItem(d.presentations[4], "Ibrahim Demirci"))
    || (d.seminar == 'Seminar 4' && request.time >= timestamp.value("2027-02-11T23:00:00Z") && request.time < timestamp.value("2027-02-18T23:00:00Z") && d.presentations.size() == 5 && validItem(d.presentations[0], "Najam Ul Sahar") && validItem(d.presentations[1], "Klementýna Kepková") && validItem(d.presentations[2], "Katarina Ćaćić") && validItem(d.presentations[3], "Yuliia Zuzak") && validItem(d.presentations[4], "Maria Filipa Rocha Martins"))
    || (d.seminar == 'Seminar 6' && request.time >= timestamp.value("2027-04-15T22:00:00Z") && request.time < timestamp.value("2027-04-22T22:00:00Z") && d.presentations.size() == 4 && validItem(d.presentations[0], "Jan Goldmund Zelený") && validItem(d.presentations[1], "Kryštof Malý") && validItem(d.presentations[2], "Jan Řeháček") && validItem(d.presentations[3], "Layleen Visisombat"))
    || (d.seminar == 'Seminar 7' && request.time >= timestamp.value("2027-05-13T22:00:00Z") && request.time < timestamp.value("2027-05-20T22:00:00Z") && d.presentations.size() == 4 && validItem(d.presentations[0], "Valérie Bížová") && validItem(d.presentations[1], "Jáchym Hrušák") && validItem(d.presentations[2], "María Martínez Mallo") && validItem(d.presentations[3], "Alireza Abbasi Kejani"));
  }
  match /votes_2026_2027/{voteId} {
   allow get, list: if false;
   allow create: if eligible()
    && request.resource.data.keys().hasOnly(['participant','uid','seminar','presentations','timestamp'])
    && request.resource.data.keys().hasAll(['participant','uid','seminar','presentations','timestamp'])
    && request.resource.data.participant == request.auth.token.email
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.seminar is string
    && ((request.resource.data.seminar == 'Seminar 1' && voteId == 'Seminar_1_' + request.auth.uid) || (request.resource.data.seminar == 'Seminar 2' && voteId == 'Seminar_2_' + request.auth.uid) || (request.resource.data.seminar == 'Seminar 3' && voteId == 'Seminar_3_' + request.auth.uid) || (request.resource.data.seminar == 'Seminar 4' && voteId == 'Seminar_4_' + request.auth.uid) || (request.resource.data.seminar == 'Seminar 6' && voteId == 'Seminar_6_' + request.auth.uid) || (request.resource.data.seminar == 'Seminar 7' && voteId == 'Seminar_7_' + request.auth.uid))
    && request.resource.data.timestamp == request.time
    && validSeminar(request.resource.data);
   allow update, delete: if false;
  }
  match /public_results_2026_2027/{id} { allow read: if true; allow write: if false; }
  match /presenter_feedback_2026_2027/{uid} { allow get: if eligible() && request.auth.uid == uid; allow list, create, update, delete: if false; }
  match /users_2026_2027/{email} { allow get: if request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == email; allow create, update: if false; allow list, delete: if false; }
 }
}
